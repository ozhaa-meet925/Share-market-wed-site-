MARKET_DATA_PROVIDER=kun
# Kunpeng Data India market API (requires a member token authorized for IN/NSE).
KUN_DATA_API_TOKEN=paste_your_kunpeng_member_token_here
KUN_DATA_API_BASE_URL=https://api.kun.pro
KUN_DATA_WS_URL=ws://ws.kun.pro/ws
KUN_DATA_MARKET=IN
KUN_DATA_EXCHANGE=NSE
# Optional Yahoo Finance research fallback. Install once with `npm run setup:yfinance`.
# It is not real-time; set YFINANCE_RESEARCH_ENABLED=false to disable it.
YFINANCE_RESEARCH_ENABLED=true
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
ALPHA_VANTAGE_SYMBOL_SUFFIX=.BSE
# Optional key for authenticated goldprice.dev spot quotes. Keep this server-side.
GOLDPRICE_API_KEY=your_goldprice_api_key_here
# Live market headlines through Finnhub. Without this, the app serves fallback headlines.
FINNHUB_API_KEY=your_finnhub_api_key_here
# Calendar feeds (kept server-side). Use an FMP plan that includes Indian market data.
FMP_API_KEY=your_fmp_api_key_here
# Google Gemini for the external AI copilot. Without this, the built-in engine is used.
GEMINI_API_KEY=your_gemini_api_key_here
# Free, read-only Upstox Analytics Token from Developer Apps > Analytics.
# Supports the IPO read APIs and remains valid for 1 year.
UPSTOX_ACCESS_TOKEN=paste_your_upstox_analytics_token_here
UPSTOX_SYMBOL_MAP=RELIANCE=NSE_EQ|INE002A01018,TCS=NSE_EQ|INE467B01029

# Optional: per-user Upstox OAuth for submitting and tracking IPO applications.
# Register this exact callback URL in your Upstox app; change the host to your Vite/deployed domain.
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:5173/api/ipo/auth/callback
# Generate a private random value (at least 32 characters); used to sign OAuth state and encrypt user sessions.
IPO_SESSION_SECRET=replace_with_a_private_random_secret_at_least_32_characters
ZERODHA_API_KEY=your_zerodha_api_key_here
ZERODHA_ACCESS_TOKEN=your_zerodha_access_token_here

# ── Optional Groww API (https://groww.in/trade-api/docs) ──
# Add your active Groww Trading API access token. Tokens expire daily.
GROWW_ACCESS_TOKEN=your_groww_access_token_here
GROWW_SYMBOL_MAP=

PORT_PROXY=3001
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_secret
