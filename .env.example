MARKET_DATA_PROVIDER=kun
# Kunpeng Data India market API (requires a member token authorized for IN/NSE).
KUN_DATA_API_TOKEN=paste_your_kunpeng_member_token_here
KUN_DATA_API_BASE_URL=https://api.kun.pro
KUN_DATA_WS_URL=ws://ws.kun.pro/ws
KUN_DATA_MARKET=IN
KUN_DATA_EXCHANGE=NSE
# Optional Yahoo Finance research fallback. Install once with `npm run setup:yfinance`.
# It is not real-time; set YFINANCE_RESEARCH_ENABLED=false to disable it.
YFINANCE_RESEARCH_ENABLED=true
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
ALPHA_VANTAGE_SYMBOL_SUFFIX=.BSE
# Optional key for authenticated goldprice.dev spot quotes. Keep this server-side.
GOLDPRICE_API_KEY=your_goldprice_api_key_here
# Optional Finnhub primary source for market headlines. Without a key, the server fetches Google News RSS headlines.
FINNHUB_API_KEY=your_finnhub_api_key_here
# Calendar feeds (kept server-side). Use an FMP plan that includes Indian market data.
FMP_API_KEY=your_fmp_api_key_here
# Google Gemini for the external AI copilot. Without this, the built-in engine is used.
GEMINI_API_KEY=your_gemini_api_key_here
# Optional model override. Retired models fall back to gemini-flash-lite-latest automatically.
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional Upstox read-only token for market-data integrations. Not required for live IPO listings.
UPSTOX_ACCESS_TOKEN=paste_your_upstox_analytics_token_here
UPSTOX_SYMBOL_MAP=RELIANCE=NSE_EQ|INE002A01018,TCS=NSE_EQ|INE467B01029

# Optional: per-user Upstox OAuth for submitting and tracking IPO applications.
# Register this exact callback URL in your Upstox app; change the host to your Vite/deployed domain.
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:5173/api/ipo/auth/callback
# Generate a private random value (at least 32 characters); used to sign OAuth state and encrypt user sessions.
IPO_SESSION_SECRET=replace_with_a_private_random_secret_at_least_32_characters
ZERODHA_API_KEY=your_zerodha_api_key_here
ZERODHA_API_SECRET=your_zerodha_api_secret_here
ZERODHA_ACCESS_TOKEN=your_zerodha_access_token_here
# paper | sandbox | live. Zerodha has no official sandbox; set a mock base URL before sandbox orders.
ZERODHA_TRADING_MODE=paper
ZERODHA_SANDBOX_BASE_URL=
ZERODHA_POSTBACK_TOKEN=
# paper | sandbox | live. Sandbox requires UPSTOX_SANDBOX_API_BASE from your Upstox sandbox docs.
UPSTOX_TRADING_MODE=paper
UPSTOX_SANDBOX_API_BASE=
# Master switch for live broker order routing. Keep 0 until written authorization and testing are complete.
LIVE_TRADING_ENABLED=0
# Encrypts broker tokens at rest (32+ random characters). Falls back to AUTH_SESSION_SECRET.
BROKER_TOKEN_KEY=

# ── Optional SMTP delivery for opted-in trade, order, risk and news email alerts ──
# Leave SMTP_HOST empty to keep email reported as "not configured"; in-app alerts still work.
SMTP_HOST=
SMTP_PORT=587
# Set to 1 for implicit TLS (port 465 does this automatically).
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
# Defaults to SMTP_USER when empty.
SMTP_FROM=

# ── Optional standards-based background browser push (keep private key server-side) ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ── Optional Groww API (https://groww.in/trade-api/docs) ──
# Add your active Groww Trading API access token. Tokens expire daily.
GROWW_ACCESS_TOKEN=your_groww_access_token_here
GROWW_SYMBOL_MAP=

PORT_PROXY=3001
# Set NODE_ENV=production on a public deployment. That hides demo OTPs automatically.
NODE_ENV=development
# Explicitly re-enable the demo OTP in production (only for a private test server).
AUTH_SHOW_DEMO_OTP=0
# Force-hide the demo OTP even outside production.
AUTH_HIDE_DEMO_OTP=0
# Global per-IP limit for /api requests (per minute). Set API_RATE_LIMIT_DISABLED=1 to turn it off.
API_RATE_LIMIT_PER_MIN=900
# Optional bearer secret for an external scheduler calling /api/cron/notifications.
CRON_SECRET=
# Forwarded-header trust: loopback (default), false, true, or a hop count. Use 1 behind one reverse proxy.
TRUST_PROXY=loopback
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_secret
